# Segredos e dados reais — NUNCA versionar
config.json
*.pfx
*.pem
*.p12

# Dados fiscais reais capturados
dados-fiscais/
/root/dados-fiscais/
testdata/danfe/*.xml
testdata/danfe/*.pdf

# Binários compilados (o usuário baixa via release, não commita)
dist/
*.exe

# Checkpoints (estado local de execução, não é código)
.checkpoint-*

# Log de diagnóstico do instalador/painel (gerado ao rodar o .exe no Windows)
instalador-debug.log
painel-debug.log
diagnostico-dialogo.log

# Notas internas (nome da empresa, infra específica) — não é público
OPERACAO_INTERNA.md

# Nunca deveriam existir aqui, mas se algum comando rodar sem $HOME
# configurado direito, cria essas pastas locais com dado sensível
# (ex: sessão do Bitwarden CLI). Bloqueio de segurança extra.
.config/
.local/
mingw-case-fix/
